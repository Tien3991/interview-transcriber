# Copy this file to .env and fill in your key from https://console.soniox.com
SONIOX_API_KEY=
# Optional: back up every recording + transcript to Dropbox (app token from
# https://www.dropbox.com/developers/apps — needs the files.content.write scope).
# Served to the local page via /api/config and embedded into dist/ by build.js.
# DROPBOX_TOKEN=
# Optional overrides:
# SONIOX_MODEL=stt-async-v5
# PORT=4823
